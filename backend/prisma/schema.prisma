datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Cliente {
  id               String    @id @default(uuid())
  nome             String
  cpf              String?   @unique
  rg               String?   // Documento de identidade RG
  nasc             String?   // ISO Date String or Date
  sexo             String?
  tel              String?
  email            String?
  endereco         String?
  obs              String?
  ativo            Boolean   @default(true)
  alergiasCliente  String?   @map("alergias_cliente")
  medicoReferencia String?   @map("medico_referencia")
  servicos         Servico[]

  @@index([nome])
  @@index([ativo])
  @@map("clientes")
}

model Servico {
  id              String    @id @default(uuid())
  clienteId       String    @map("cliente_id")
  cliente         Cliente   @relation(fields: [clienteId], references: [id])
  tipo            String    // 'manipulacao', 'exame', 'produto'
  data            String    // Date string (YYYY-MM-DD)
  valor           Decimal   @db.Decimal(10, 2)
  pagamento       String    // 'dinheiro', 'pix', 'debito', 'credito', 'pendente'
  obs             String?
  orcNum          Int       @map("orc_num")
  formula         String?
  prazo           String?
  tipoExame       String?   @map("tipo_exame")
  produtoDesc     String?   @map("produto_desc")
  criadoPor       String?   @map("criado_por")
  resultadoExame  String?   @map("resultado_exame")
  laboratorio     String?
  dataEntregaReal String?   @map("data_entrega_real")
  criadoEm        DateTime? @default(now()) @map("criado_em")

  @@index([clienteId])
  @@index([tipo])
  @@index([data])
  @@index([orcNum])
  @@map("servicos")
}

model SystemUser {
  id       String   @id @default(uuid())
  nome     String
  email    String   @unique
  perfil   String   // 'admin', 'gerente', 'farmaceutico', 'atendente'
  perms    Json     // Permissions map
  ativo    Boolean  @default(true)
  authId   String?  @map("auth_id")
  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([ativo])
  @@map("system_users")
}

model TipoExame {
  id           String   @id @default(uuid())
  nome         String
  valor        Decimal  @db.Decimal(10, 2)
  ativo        Boolean  @default(true)
  ordem        Int      @default(0)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @default(now()) @map("atualizado_em")

  @@index([ativo, ordem])
  @@map("tipos_exames")
}

